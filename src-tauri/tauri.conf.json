{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koteyye media studio",
  "version": "2.0.0",
  "identifier": "ru.koteyye.media-studio",
  "build": {
    "beforeDevCommand": { "script": "dx serve --web --port 8080 --open false", "cwd": "../ui" },
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": { "script": "dx bundle --platform web --release", "cwd": "../ui" },
    "frontendDist": "../ui/dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koteyye Media Studio 2.0",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
